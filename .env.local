# ============================================================
# Peleka Courier - Backend Environment Variables (v2.0)
# Copy this file to .env.local (dev) or .env (prod) and fill in.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# --- PostgreSQL ---
# For Neon, use the POOLED URL here (contains "-pooler" in hostname).
#DATABASE_URL=postgresql://user:pass@host:5432/peleka?sslmode=require
# For migrations & seed, use the DIRECT URL (no PgBouncer).
#DIRECT_URL=postgresql://user:pass@host:5432/peleka?sslmode=require
# Or use discrete values (DATABASE_URL wins if set).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=peleka
PGSSL=false
# Recommended for serverless hosts (Vercel, etc.) so we don't exhaust Neon connections.
PG_POOL_MAX=5

# --- JWT / Auth ---
# Generate strong secrets, e.g.:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_min_64_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_64_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# --- Google Maps ---
# Used for Directions/Distance Matrix on server-side price calculation.
#GOOGLE_MAPS_API_KEY=your_google_maps_server_key
PRICE_FALLBACK_USE_HAVERSINE=true

# Enable OSRM as the primary distance provider (default: true).
# Set to "false" to skip OSRM and use Google or Haversine.
OSRM_ENABLED=true

# OSRM server URL.
# - Leave blank to use the public demo (https://router.project-osrm.org).
#   ⚠️  Demo is fair-use only — fine for MVP/dev, NOT for production traffic.
# - Set to your own self-hosted OSRM URL for production.
OSRM_URL=https://router.project-osrm.org

# --- Google Sign-In (v2) ---
# Comma-separated list of allowed OAuth client IDs (web + iOS + Android).
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com

# --- SMS provider for phone OTP (v2) ---
# Leave SMS_PROVIDER blank in dev — codes will be logged to stdout AND
# returned in the response as `_dev_code` (never returned in production).
SMS_PROVIDER=            # twilio | at | (blank = dev/log-only)
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1234567890
# Africa's Talking
AT_USERNAME=
AT_API_KEY=
AT_FROM=Peleka

# --- OTP tuning (v2) ---
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60

# --- File Uploads ---
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:3000/uploads
MAX_UPLOAD_MB=10

# --- Rate limiting (simple in-memory for dev) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Notifications (optional) ---
FCM_SERVER_KEY=

# --- Bootstrap admin (created by seed) ---
BOOTSTRAP_ADMIN_EMAIL=admin@peleka.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!123
BOOTSTRAP_ADMIN_NAME=Peleka Admin
